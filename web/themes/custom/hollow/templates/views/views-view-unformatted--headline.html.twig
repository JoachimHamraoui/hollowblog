{# templates/views/views-view-unformatted--headline.html.twig #}

<div class="headline-grid">
  {% if rows[0] is defined %}
    <div class="headline-grid__primary">
      <div class="headline-grid__item headline-grid__item__primary">
        {{ rows[0].content }}
      </div>
    </div>
  {% endif %}

  {% if rows|length > 1 %}
    <div class="headline-grid__secondary">
      {% for row in rows|slice(1) %}
        <div class="headline-grid__item headline-grid__item__secondary">
          {{ row.content }}
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>